page {
  background: #f6f2ea;
  color: #26211c;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 48rpx;
}

.hero {
  padding: 36rpx 30rpx;
  border-radius: 16rpx;
  background: #101820;
  color: #fffaf2;
  box-shadow: 0 18rpx 40rpx rgba(16, 24, 32, 0.16);
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 250, 242, 0.76);
  font-size: 26rpx;
  line-height: 1.55;
}

.section-title {
  display: block;
  margin: 34rpx 4rpx 18rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.song-card,
.panel {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(38, 33, 28, 0.08);
  border-radius: 14rpx;
  background: #fffaf2;
}

.song-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.song-main {
  min-width: 0;
  flex: 1;
}

.song-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #221c17;
}

.song-meta {
  display: block;
  margin-top: 8rpx;
  color: #7c7468;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #efe4d2;
  color: #675b4e;
  font-size: 22rpx;
}

.primary-button,
.ghost-button {
  min-width: 132rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 64rpx;
}

.primary-button {
  background: #d04f3a;
  color: #fff;
}

.ghost-button {
  border: 1rpx solid #d04f3a;
  background: transparent;
  color: #d04f3a;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(38, 33, 28, 0.12);
  border-radius: 12rpx;
  background: #fffaf2;
  color: #26211c;
  font-size: 30rpx;
}

.input {
  min-height: 88rpx;
}

.textarea {
  min-height: 260rpx;
  line-height: 1.55;
}

.empty {
  padding: 42rpx 20rpx;
  color: #8c8377;
  text-align: center;
  font-size: 26rpx;
}

.list-note {
  display: block;
  color: #8c8377;
  font-size: 24rpx;
  line-height: 1.55;
}
